# Copied to .env by `make setup`; `make env-upgrade` adds new variables. Secrets are generated. Never commit .env.
AEGIS_ENV=development
AEGIS_POSTGRES_USER=aegis
AEGIS_POSTGRES_DB=aegis
AEGIS_POSTGRES_PASSWORD=__GENERATED_BY_MAKE_SETUP__
AEGIS_POSTGRES_PORT=5433
AEGIS_DB_OWNER_PASSWORD=__GENERATED_BY_MAKE_SETUP__
AEGIS_DB_APP_PASSWORD=__GENERATED_BY_MAKE_SETUP__
